DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/razor"
ADMIN_USERNAME="Admin"
ADMIN_EMAIL="admin@tudominio.com"
# Generar con: npm run admin:password -- "TuNuevaContraseña"
ADMIN_PASSWORD_HASH="scrypt:REEMPLAZAR_SALT:REEMPLAZAR_HASH"
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO"
# Cloudflare Turnstile. En desarrollo pueden usarse las claves de prueba oficiales.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Correo para recuperación de contraseña (Resend).
RESEND_API_KEY="re_REEMPLAZAR"
EMAIL_FROM="Razor Admin <no-reply@tudominio.com>"
APP_URL="http://localhost:3000"
